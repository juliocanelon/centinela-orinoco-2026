        <mxCell id="ui-reports" value="&lt;b&gt;Reportes comunitarios&lt;/b&gt;&lt;br&gt;Captura, consulta y seguimiento de evidencias e incidentes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
