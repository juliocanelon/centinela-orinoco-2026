        </mxCell>

        <mxCell id="api-ingestion" value="&lt;b&gt;Ingesta directa y programada&lt;/b&gt;&lt;br&gt;Consulta fuentes, normaliza registros, filtra por zona y actualiza los datos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="655" y="175" width="265" height="115" as="geometry" />
        </mxCell>
        <mxCell id="api-analytics" value="&lt;b&gt;Procesamiento territorial&lt;/b&gt;&lt;br&gt;Análisis por zona, densidad de alertas y preparación de datos para el mapa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="655" y="350" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="api-ai" value="&lt;b&gt;API de preguntas y respuestas&lt;/b&gt;&lt;br&gt;Recibe la pregunta, reúne el contexto y los datos actuales, solicita una respuesta a Gemini y la devuelve a la interfaz. Usa respuesta táctica alternativa si la IA no está disponible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="655" y="475" width="265" height="140" as="geometry" />
        </mxCell>
        <mxCell id="api-reports" value="&lt;b&gt;Servicios de reportes y documentos&lt;/b&gt;&lt;br&gt;Valida reportes, procesa el corpus y gestiona evidencias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="655" y="650" width="265" height="95" as="geometry" />
        </mxCell>

