        <mxCell id="src-data" value="&lt;b&gt;Fuentes de datos&lt;/b&gt;&lt;br&gt;NASA FIRMS: focos térmicos&lt;br&gt;Copernicus STAC: Sentinel-1, 2 y 3&lt;br&gt;INAMEH: niveles hidrométricos&lt;br&gt;Corpus: PDF, texto y DOI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
