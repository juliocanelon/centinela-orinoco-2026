        </mxCell>
        <mxCell id="src-user" value="&lt;b&gt;Comunidades y analistas&lt;/b&gt;&lt;br&gt;Registran reportes y consultan alertas, mapas e información ambiental." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#15803D;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=9;" vertex="1" parent="1">
