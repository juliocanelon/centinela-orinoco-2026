        <mxCell id="src-community" value="&lt;b&gt;Comunidades y operadores&lt;/b&gt;&lt;br&gt;Denuncias, coordenadas, narrativas y evidencias; captura desde la interfaz.&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Kobo/ODK: rutas disponibles; fuente activa no acreditada.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
