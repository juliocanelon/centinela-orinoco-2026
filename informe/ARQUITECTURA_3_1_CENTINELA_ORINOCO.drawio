        </mxCell>
        <mxCell id="src-docs" value="&lt;b&gt;Corpus documental&lt;/b&gt;&lt;br&gt;PDF, texto y URL/DOI para extraccion y catalogacion cientifica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="278" width="205" height="78" as="geometry" />
        </mxCell>
        <mxCell id="src-geo" value="&lt;b&gt;Datos locales de referencia&lt;/b&gt;&lt;br&gt;GeoJSON territorial, limites y conjuntos iniciales/mock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="382" width="205" height="80" as="geometry" />
        </mxCell>
        <mxCell id="src-sat" value="&lt;b&gt;Eventos ambientales de demostracion&lt;/b&gt;&lt;br&gt;FIRMS / Sentinel-1 / Sentinel-2 / telemetria.&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;El scheduler genera valores sinteticos; no es observacion real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="490" width="205" height="112" as="geometry" />
        </mxCell>
        <mxCell id="src-human" value="&lt;b&gt;Usuario final&lt;/b&gt;&lt;br&gt;Analista / personal ambiental revisa alertas, mapas y reportes.&lt;br&gt;Decision final con revision humana." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#15803D;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="635" width="205" height="95" as="geometry" />
        </mxCell>

        <mxCell id="ui-app" value="&lt;b&gt;Aplicacion cliente&lt;/b&gt;&lt;br&gt;React 19 + Vite&lt;br&gt;Estado de vistas y coordinacion entre modulos (src/App.tsx)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="145" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ui-map" value="&lt;b&gt;Mapa tactico geoespacial&lt;/b&gt;&lt;br&gt;Capas de anomalias, mineria, hidrologia, areas protegidas, incidentes, denuncias y sitios del corpus.&lt;br&gt;Leaflet / GeoJSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="260" width="230" height="112" as="geometry" />
        </mxCell>
        <mxCell id="ui-ops" value="&lt;b&gt;Operacion y monitoreo&lt;/b&gt;&lt;br&gt;Telemetria, visor SAR, gestion de incidentes y denuncias comunitarias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="398" width="230" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ui-tools" value="&lt;b&gt;Ingesta, investigacion e IA&lt;/b&gt;&lt;br&gt;Scheduler y conectores; lector del corpus; analisis por zona, chat y boletines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="512" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ui-fallback" value="&lt;b&gt;Respaldo local del navegador&lt;/b&gt;&lt;br&gt;Datos iniciales y localStorage para denuncias comunitarias.&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;No es una cola offline durable.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="312" y="625" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="api-rest" value="&lt;b&gt;Servidor Express&lt;/b&gt;&lt;br&gt;API REST /api: ingesta, telemetria, scheduler, corpus, denuncias e IA.&lt;br&gt;Vite integrado en desarrollo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="612" y="145" width="310" height="88" as="geometry" />
        </mxCell>
        <mxCell id="api-scheduler" value="&lt;b&gt;SatelliteAutomatedScheduler&lt;/b&gt;&lt;br&gt;Tareas FIRMS, Sentinel-1, Sentinel-2 y telemetria; eventos de demostracion y stores en memoria.&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Cadencias no equivalen a ingesta real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="612" y="256" width="310" height="108" as="geometry" />
        </mxCell>
        <mxCell id="api-community" value="&lt;b&gt;Denuncias y saga hibrida&lt;/b&gt;&lt;br&gt;Validacion de reporte; elevacion a incidente solo tras confirmacion; idempotencia, RPC y compensacion de fallo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="612" y="388" width="310" height="92" as="geometry" />
        </mxCell>
        <mxCell id="api-corpus" value="&lt;b&gt;Ingesta del corpus&lt;/b&gt;&lt;br&gt;Extraccion de PDF; DOI/Crossref; metadatos y analisis de texto con Gemini; intenta sincronizar documentos en Supabase.&lt;br&gt;No valida por si solo indexacion academica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="612" y="504" width="310" height="108" as="geometry" />
        </mxCell>
        <mxCell id="api-ai" value="&lt;b&gt;Analitica de zona y RAG de demostracion&lt;/b&gt;&lt;br&gt;Consulta datos/almacenes de respaldo y solicita sintesis a Gemini.&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;La ruta vector-search devuelve coincidencias fijas; no ejecuta busqueda vectorial real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="612" y="636" width="310" height="116" as="geometry" />
        </mxCell>

        <mxCell id="db-postgres" value="&lt;b&gt;Supabase / PostgreSQL + PostGIS&lt;/b&gt;&lt;br&gt;Persistencia implementada de denuncias, incidentes y operaciones de integracion; funciones RPC y geometria.&lt;br&gt;Servicio opcional por variables de entorno." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="992" y="145" width="246" height="112" as="geometry" />
        </mxCell>
        <mxCell id="db-storage" value="&lt;b&gt;Supabase Storage&lt;/b&gt;&lt;br&gt;Bucket privado de evidencias; referencias y URLs firmadas para medios de denuncias.&lt;br&gt;Requiere configuracion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="992" y="290" width="246" height="92" as="geometry" />
        </mxCell>
        <mxCell id="db-mongo" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;Coleccion documental de evidencias ligada al incidente; escritura idempotente (upsert).&lt;br&gt;Conexion bajo demanda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="992" y="410" width="246" height="92" as="geometry" />
        </mxCell>
        <mxCell id="db-memory" value="&lt;b&gt;Stores en memoria del servidor&lt;/b&gt;&lt;br&gt;Eventos y corpus durante la ejecucion; respaldo volatil, se pierde al reiniciar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="992" y="530" width="246" height="82" as="geometry" />
        </mxCell>
        <mxCell id="db-rag" value="&lt;b&gt;Esquema RAG/vectorial de referencia&lt;/b&gt;&lt;br&gt;Se declara vector(768), PostGIS y RPC en codigo cliente; no se verifico migracion ni embedding efectivo en las migraciones entregadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="992" y="640" width="246" height="112" as="geometry" />
        </mxCell>

        <mxCell id="ext-gemini" value="&lt;b&gt;Google Gemini API&lt;/b&gt;&lt;br&gt;Analisis y generacion de texto; cascada de modelos en backend.&lt;br&gt;Opcional: requiere GEMINI_API_KEY." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1302" y="145" width="286" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-crossref" value="&lt;b&gt;Crossref / DOI&lt;/b&gt;&lt;br&gt;Resolucion de metadatos bibliograficos cuando se detecta DOI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1302" y="278" width="286" height="82" as="geometry" />
        </mxCell>
        <mxCell id="ext-satellite" value="&lt;b&gt;Catalogos NASA / Copernicus&lt;/b&gt;&lt;br&gt;Proveedores nombrados en el prototipo y conectores de interfaz.&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;El scheduler inspeccionado no demuestra descarga real de productos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1302" y="394" width="286" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ext-deploy" value="&lt;b&gt;Despliegue y configuracion&lt;/b&gt;&lt;br&gt;Node.js + Express/Vite local; Supabase, MongoDB y Gemini se habilitan mediante secretos/configuracion.&lt;br&gt;No se encontraron artefactos Docker/Kubernetes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;fontColor=#102A43;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1302" y="530" width="286" height="106" as="geometry" />
        </mxCell>
        <mxCell id="ext-warning" value="&lt;b&gt;Limite de uso&lt;/b&gt;&lt;br&gt;Prototipo academico. No usar como evidencia ambiental ni para activar operativos sin validacion independiente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#7F1D1D;fontSize=12;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1302" y="675" width="286" height="88" as="geometry" />
        </mxCell>

